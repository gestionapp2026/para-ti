# URI de conexion a MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/enamorar?retryWrites=true&w=majority

# Secreto para firmar los JWT del panel de administracion
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Contrasena para entrar al panel de creador (vista tuya)
ADMIN_PASSWORD=cambia-esta-clave

# Codigo opcional para proteger la vista de tu novia (deja vacio para desactivar)
GF_ACCESS_CODE=

# URL del frontend desplegado en GitHub Pages, para CORS (puedes separar varias con coma)
FRONTEND_URL=http://localhost:5173

# Puerto (Render lo asigna automaticamente en produccion)
PORT=5000
